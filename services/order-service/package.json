{
  "name": "order-service",
  "version": "1.0.0",
  "private": true,
  "description": "GraphQL API + transactional outbox + Kafka producer/consumer",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "graphql": "^16.14.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
